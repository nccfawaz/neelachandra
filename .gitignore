# deps
node_modules/

# env: never commit. Values live in hPanel environment variables.
.env
.env.*
!.env.example
.dev.vars

# build output
dist/
.wrangler/

# parity gate output. Regenerated on every run; the GOLDEN masters under
# legacy/golden/ are committed and must never be ignored.
tests/parity-out/

# logs
logs/
*.log
npm-debug.log*

# editor / os
.vscode/*
!.vscode/launch.json
.idea/
.DS_Store

# ---------------------------------------------------------------------------
# NOTE: nothing here ignores src/, public/ or tsconfig.json.
#
# An earlier revision ignored those paths to keep the sandbox Cloudflare Pages
# scaffold out of the repository. That scaffold has now been deleted from the
# root and archived verbatim under legacy/sandbox-scaffold/ instead, so the
# ignore rules were removed.
#
# This matters for phase 1: the real application creates src/ and public/ and
# its own tsconfig.json. If those rules were still here, an implementer would
# write the entire public site and silently commit none of it.
# ---------------------------------------------------------------------------
