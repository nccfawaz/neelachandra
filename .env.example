# Neelachandra platform environment template (spec section 2.12)
# Copy to .env and fill in real values. Never commit .env.

# MariaDB connection (Hostinger production values come from hPanel)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# 32+ byte random string. Derives the AES-256-GCM key that encrypts
# TOTP secrets at rest, and signs session id hashing.
SESSION_SECRET=

# Shared secret required by the internal cron endpoints (src/internal/cron)
CRON_SECRET=

# Hostinger SMTP for transactional mail (implicit TLS on 465)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# Upload roots, both outside git. Public files are served statically from
# UPLOAD_PUBLIC_DIR; private files are streamed through permission checks.
UPLOAD_PUBLIC_DIR=./uploads/public
UPLOAD_PRIVATE_DIR=./uploads/private

# IndexNow key file is served verbatim at /<key>.txt so the value is public
# by design (spec 2.12).
INDEXNOW_KEY=097ee841c58a4b25b8eb2c348ca67dce

# Absolute origin of this deployment, no trailing slash
APP_BASE_URL=http://localhost:3000

# development | production
NODE_ENV=development

# Local dev server port (not used in production, Hostinger assigns it)
PORT=3000
