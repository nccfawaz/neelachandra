{
  "name": "neelachandra-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Neelachandra Construction and Interiors: public site and internal staff platform.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-runtime-data.mjs && vite build",
    "build:server": "tsc -p tsconfig.json && node scripts/copy-runtime-data.mjs",
    "build:client": "vite build",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:parity": "node scripts/selftest-parity.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:types": "node scripts/gen-db-types.mjs",
    "seed:reference": "node scripts/seed-reference.mjs",
    "reconcile:stock": "node scripts/reconcile-stock.mjs",
    "seed:owner": "node scripts/seed-users.mjs --owner",
    "capture:golden": "node scripts/capture-golden.mjs",
    "capture:golden:html": "node scripts/capture-golden.mjs --html-only",
    "capture:assets": "node scripts/capture-assets.mjs",
    "capture:assets:verify": "node scripts/capture-assets.mjs --verify",
    "parity": "node scripts/parity-check.mjs",
    "parity:selftest": "node scripts/selftest-parity.mjs",
    "build:site": "node scripts/build-site.mjs",
    "build:site:check": "node scripts/build-site.mjs --check",
    "build:errors": "node scripts/build-error-pages.mjs",
    "build:login": "node scripts/build-login-page.mjs",
    "build:all": "node scripts/build-site.mjs && node scripts/build-error-pages.mjs && node scripts/build-login-page.mjs",
    "test:htaccess": "node scripts/test-htaccess.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^7.0.12",
    "@types/qrcode": "^1.5.6",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@node-rs/argon2": "^2.2.0",
    "hono": "^4.13.5",
    "kysely": "^0.27.6",
    "mysql2": "^3.24.2",
    "nodemailer": "^7.0.13",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "zod": "^3.25.76"
  }
}
